@@ -290,7 +290,15 @@ bool Component::isShowing() const
         return parentComponent->isShowing();
 
     if (auto* peer = getPeer())
+    {
+       #if KICK_EMU
+        // The emulator minimises Kick's window and draws it inside the KICK Surface, so it still counts as showing.
+        ignoreUnused (peer);
+        return true;
+       #else
         return ! peer->isMinimised();
+       #endif
+    }
 
     return false;
 }
@@ -1095,7 +1103,16 @@ bool Component::contains (Point<float> point)
 
         if (flags.hasHeavyweightPeerFlag)
             if (auto* peer = getPeer())
+            {
+               #if KICK_EMU
+                // The peer asks the OS which window is on top. The emulated window is minimised behind the KICK Surface,
+                // which injects touches into it, so the hit test above is the whole answer.
+                ignoreUnused (peer);
+                return true;
+               #else
                 return peer->contains (detail::ComponentHelpers::localPositionToRawPeerPos (*this, point).roundToInt(), true);
+               #endif
+            }
     }
 
     return false;
@@ -2593,10 +2610,16 @@ void Component::takeKeyboardFocus (FocusChangeType cause, FocusChangeDirection d
     if (auto* peer = getPeer())
     {
         const WeakReference<Component> safePointer (this);
+       #if KICK_EMU
+        // The unit has one window and it always has focus. The emulated window sits behind the KICK Surface and is
+        // never the OS key window, so keep focus inside it without asking the OS (which would also steal activation).
+        ignoreUnused (peer);
+       #else
         peer->grabFocus();
 
         if (! peer->isFocused() || currentlyFocusedComponent == this)
             return;
+       #endif
 
         WeakReference<Component> componentLosingFocus (currentlyFocusedComponent);
 
